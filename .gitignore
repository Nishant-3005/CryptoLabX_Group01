# ── Resources & Lab PDFs ───────────────────────────────────────────────────
resources/

# ── Python bytecode & cache ─────────────────────────────────────────────────
# Auto-generated by Python when running .py files. Never commit these.
__pycache__/
*.py[cod]          # matches .pyc, .pyo, .pyd
*.pyo
*.pyd

# ── Virtual environments ─────────────────────────────────────────────────────
# If you create a venv inside the project folder, exclude it
venv/
.venv/
env/
.env/

# ── CryptoLabX log files ─────────────────────────────────────────────────────
# Logs are generated at runtime and are machine/session-specific
outputs/*.log

# ── OS-generated junk ────────────────────────────────────────────────────────
.DS_Store          # macOS Finder metadata
Thumbs.db          # Windows thumbnail cache
desktop.ini        # Windows folder settings

# ── IDE / Editor config ──────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Sensitive / secret files ─────────────────────────────────────────────────
# NEVER commit API keys, passwords, or secret keys
.env
secrets.py
config_secret.py

# ── Compiled C extensions ────────────────────────────────────────────────────
*.so
*.dll